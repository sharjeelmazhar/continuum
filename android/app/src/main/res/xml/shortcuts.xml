<?xml version="1.0" encoding="utf-8"?>
<!-- The paired computer is published at runtime as a sharing shortcut (share/Shortcuts.kt). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="io.github.sharjeelmazhar.continuum.ShareActivity">
        <data android:mimeType="*/*" />
        <category android:name="io.github.sharjeelmazhar.continuum.category.SEND_TO_COMPUTER" />
    </share-target>
</shortcuts>
