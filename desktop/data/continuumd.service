[Unit]
Description=Continuum (phone connection service)
After=network-online.target
# Not for the login screen's own session (gdm, sddm, lightdm system users).
ConditionUser=!@system

[Service]
Type=dbus
BusName=io.github.sharjeelmazhar.Continuum.Daemon
ExecStart=%h/.local/bin/continuumd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
